# What `gcloud run deploy --source .` uploads: an ALLOWLIST. Ignore everything, then re-include only what the
# Dockerfile copies. Safer than a blocklist: .env, tests and iCloud-only files we don't need can't sneak in
# (an iCloud-only file would hang the upload, Bug Journal #13).
# Every rule starts with "/" so it only matches at the repo root: an unanchored "data/*" also matched
# synthetic_inbox/data/ and silently dropped inbox.mbox (checked with: gcloud meta list-files-for-upload .).
/*
!/Dockerfile
!/.dockerignore
!/requirements.txt

!/dj_inbox/
**/__pycache__/
**/.DS_Store

!/evals/
/evals/*
!/evals/__init__.py
!/evals/run_baseline.py
!/evals/score.py

!/synthetic_inbox/
/synthetic_inbox/*
!/synthetic_inbox/data/
/synthetic_inbox/data/*
!/synthetic_inbox/data/inbox.mbox

!/data/
/data/*
!/data/processed/
/data/processed/*
!/data/processed/leads.jsonl
!/data/embeddings/
/data/embeddings/*
!/data/embeddings/vectors.json
